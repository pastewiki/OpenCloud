# Copy to .env (never commit .env). Used by examples and integration tests.
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_UNIVERSE_ID=

# Integration tests only run when this is set to 1.
ROBLOX_INTEGRATION=0
# Integration tests only write to this data store; create a dedicated test experience.
ROBLOX_TEST_DATA_STORE=sdk-integration-tests
