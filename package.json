{
  "name": "@roblox-open-cloud/sdk",
  "version": "0.1.0",
  "description": "Typed, server-side TypeScript SDK for the Roblox Open Cloud API (unofficial).",
  "license": "MIT",
  "author": "pastewiki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pastewiki/OpenCloud.git"
  },
  "homepage": "https://github.com/pastewiki/OpenCloud#readme",
  "bugs": {
    "url": "https://github.com/pastewiki/OpenCloud/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "roblox",
    "open-cloud",
    "sdk",
    "datastore",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
